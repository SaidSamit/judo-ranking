# ==============================================================================
# CONFIGURACIÓN DE SUPABASE & NEXT.JS (JUDO TOURNAMENT PLATFORM)
# ==============================================================================

# 1. URL base de tu proyecto Supabase (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# 2. Clave anónima pública (Dashboard -> Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Clave privada Service Role (Dashboard -> Settings -> API -> service_role secret)
# ADVERTENCIA: NUNCA usar en el frontend. Usada exclusivamente en Route Handlers (/api/auth/station-login)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. JWT Secret de Supabase (Dashboard -> Settings -> API -> JWT Settings -> JWT Secret)
# Requerido por el Route Handler para firmar tokens JWT válidos para Supabase RLS y Realtime
SUPABASE_JWT_SECRET=tu-secreto-jwt-de-supabase-aqui
